#include<stdio.h>
struct college
{
   char state[20];
   int e;
   int m;
   int d;
   int a;
};
int main()
{
   int i,n,j,max,temp,tc[206];
   struct college c[20];
   printf("Enter No.");
   scanf("%d",&n);
   printf("Enter State & No.of.Coll.");
   for(i=0;i<n;i++)
   {
      scanf("%s",c[i].state);
      scanf("%d%d%d%d",&c[i].e,&c[i].m,&c[i].d,&c[i].a);
   }
   for(i=0;i<n;i++)
   {
      tc[i]=c[i].e+c[i].m+c[i].d+c[i].a;
      printf("%s has %d Colleges\n",c[i].state,tc[i]);
   }
   for(i=0;i<n-1;i++)
   {
      for(j=1;j<n;j++)
      {
         if(tc[i]>tc[j])
         {
            temp=tc[i];
            tc[i]=tc[j];
            tc[j]=temp;
         }
         max=tc[j];
      }
   }
   printf("Max no of Colleges is %d",max);
   return 0;
}
