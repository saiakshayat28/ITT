#include <iostream>
using namespace std;
class StringOp
 {
public:
    char str[100];
    int findLength()
 {
        int len = 0;
        while (str[len] != '\0')
{
            len++;
        }
        return len;
    }
    void reverseString()
{
        int n = findLength();
        for (int i = 0; i < n / 2; i++)
 {
            char temp = str[i];
            str[i] = str[n - i - 1];
            str[n - i - 1] = temp;
        }
        cout << "Reversed String: " << str << endl;
    }
    void checkPalindrome()
 {
        int n = findLength();
        int flag = 0;
        for (int i = 0; i < n / 2; i++)
 {
            if (str[i] != str[n - i - 1])
{
                flag = 1;
                break;
            }
        }
        if (flag == 0)
            cout << "It is a Palindrome." << endl;
        else
            cout << "It is NOT a Palindrome." << endl;
    }
};
int main()
 {
    StringOp obj;
    cout << "Enter a string: ";
    cin >> obj.str;
    cout << "Length: " << obj.findLength() << endl;
    obj.checkPalindrome();
    obj.reverseString();
    return 0;
}
