#include<iostream>
#include<cstring>
class String
{
   char * str;
   public:
   String()
   {
      str=new char[1];
      str[0]='\0';
   }
   String(const char * s)
   {
    str = new char[strlen(s)+1];
    strcpy(str,s);
}
String(const char*s1,const char*s2)
{
   str=new char[strlen(s1)+strlen(s2)+1];
   strcpy(str,s1);
   strcat(str,s2);
}
~String()
{
   delete [] str;
}
void display()
{
   std::cout<<str<<std::endl;
}
};
int main()
{
   String s1;
   String s2("Sai");
   String s3("Sai","Akshaya");
   s1.display();
   s2.display();
   s3.display();
   return 0;
}
