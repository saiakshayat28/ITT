#include <iostream>
#include <string>
using namespace std;
class Person
{
public:
    string name;
    int age;
};
class Student : public Person
 {
public:
    string rollNumber;
    float marks;
    void display()
{
        cout << "\n--- Student Details ---" << endl;
        cout << "Name: " << name << endl;
        cout << "Age: " << age << endl;
        cout << "Roll Number: " << rollNumber << endl;
        cout << "Marks: " << marks << endl;
    }
};
int main()
{
    Student s;
    cout << "Enter Name: ";
    cin >> s.name;
    cout << "Enter Age: ";
    cin >> s.age;
    cout << "Enter Roll Number: ";
    cin >> s.rollNumber;
    cout << "Enter Marks: ";
    cin >> s.marks;
    s.display();
    return 0;
}
