#include<stdio.h>
int main()
{
   int mark;
   printf("Enter your mark");
   scanf("%d",&mark);
   if((mark>=91)&&(mark<=100))
      printf("Grade A");
   else if((mark>=75)&&(mark<=90))
      printf("Grade B");
   else if((mark>=50)&&(mark<=74))
      printf("Grade C");
   else if((mark>=35)&&(mark<=49))
      printf("Grade D");
   else
      printf("Grade E");
   return 0;
}
