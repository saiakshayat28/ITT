def find_maximum(num1, num2, num3)
                               # Using if-elif-else logic
                                 if num1 >= num2 and num1 >= num3:
                                        maximum = num1
                                          elif num2 >= num1 and num2 >= num3:
                                                 maximum = num2
                                                   else:
                                                          maximum = num3
                                                            return maximum

                                                         # --- Example Usage ---

                                                         # Define the three numbers
                                                         number1 = 10
                                                         number2 = 25
                                                         number3 = 15

                                                         # Call the function with the numbers and store the result
                                                         largest_number = find_maximum(number1, number2, number3)

