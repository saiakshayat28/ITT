def is_prime (num):
   if num<2:
      return False
   for i in range(2, int(num**0.5)+1):
      if num%i==0:
     return False
   return True
Primes={num for num in range(2,31))if is_prime(num) }
odds={num for num in range(1,31)if num%2!=0}
print("Prime numbers:", primes)
print("Odd numbers:", odd)
print("Union:", primes|odds)
print("Intersection:", primes & odds)
print("Difference(primes - odds):", primes - odds)
print("Symmetric difference:", primes ^ odds)
