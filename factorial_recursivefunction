#include<stdio.h>
int factorial(int);
int main()
{
   int F,n;
   printf("Enter the number for finding factorial");
   scanf("%d",&n);
   F=factorial(n);
   printf("\n Factorial of %d is%d",n,F);
}
int factorial(int n)
{
   int temp;
   if(n==0)
      return 1;
   else
      temp=n*factorial(n-1);
   return temp;
}
