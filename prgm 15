#include <iostream>
#include <vector>

using namespace std;

int main() {
    int n;
    if (!(cin >> n) || n % 2 == 0) return 0;

    int matrix[100][100];
    long long primarySum = 0, secondarySum = 0;

    // Read matrix and calculate diagonal sums
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> matrix[i][j];
            if (i == j) primarySum += matrix[i][j];
            if (i + j == n - 1) secondarySum += matrix[i][j];
        }
    }

    long long sumTotal = primarySum + secondarySum;
    long long diffTotal = primarySum - secondarySum;

    // Apply transformations
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            // Above primary diagonal: j > i
            if (j > i) {
                matrix[i][j] = sumTotal;
            }
            // Below secondary diagonal: i + j > n - 1
            else if (i + j > n - 1) {
                matrix[i][j] = diffTotal;
            }
        }
    }

    // Display result
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cout << matrix[i][j] << (j == n - 1 ? "" : " ");
        }
        cout << endl;
    }

    return 0;
}
